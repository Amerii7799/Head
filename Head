local function makeToggle(label, y, key, onChange)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, -16, 0, 34)
	btn.Position = UDim2.new(0, 8, 0, y)
	btn.BackgroundColor3 = OFF_COLOR
	btn.TextColor3 = Color3.new(1, 1, 1)
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 14
	btn.Text = label .. ": OFF"
	btn.Parent = menu
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

	btn.Activated:Connect(function()
		state[key] = not state[key]
		btn.Text = label .. ": " .. (state[key] and "ON" or "OFF")
		btn.BackgroundColor3 = state[key] and ON_COLOR or OFF_COLOR
		if onChange then onChange(state[key]) end
	end)
end

-- ===== targets cache =====
local targets = {}
local function refreshTargets()
	local list = {}
	if INCLUDE_NPCS then
		for _, d in ipairs(Workspace:GetDescendants()) do
			if d:IsA("Humanoid") and d.Parent and d.Parent ~= player.Character then
				table.insert(list, d)
			end
		end
	else
		for _, p in ipairs(Players:GetPlayers()) do
			local h = p ~= player and p.Character and p.Character:FindFirstChildOfClass("Humanoid")
			if h then table.insert(list, h) end
		end
	end
	targets = list
end

local function isTeammate(model)
	local plr = Players:GetPlayerFromCharacter(model)
	return TEAM_CHECK and plr ~= nil and plr.Team ~= nil and plr.Team == player.Team
end

-- ===== ESP =====
-- fix: BillboardGui under a ScreenGui never renders -> now parented to the target's Head.
-- Box adornment has no 31-highlight cap, so ESP still shows when Highlights run out.
local espObjs = {} -- [model] = { hl, box, bb, label, hum, root }

local function clearESP(model)
	local o = espObjs[model]
	if not o then return end
	for _, k in ipairs({ "hl", "box", "bb" }) do
		if o[k] then o[k]:Destroy() end
	end
	espObjs[model] = nil
end

local function clearAllESP()
	for model in pairs(espObjs) do clearESP(model) end
end

local function addESP(hum)
	local model = hum.Parent
	if not model or espObjs[model] then return end
	local root = model:FindFirstChild("HumanoidRootPart")
	local head = model:FindFirstChild("Head") or root
	if not root then return end

	local hl = Instance.new("Highlight")
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.FillTransparency = 0.6
	hl.OutlineTransparency = 0
	hl.FillColor = ENEMY_COLOR
	hl.OutlineColor = Color3.new(1, 1, 1)
	hl.Parent = model

	local box = Instance.new("BoxHandleAdornment")
	box.Adornee = root
	box.Size = Vector3.new(4, 6, 2)
	box.AlwaysOnTop = true
	box.ZIndex = 5
	box.Transparency = 0.65
	box.Color3 = ENEMY_COLOR
	box.Parent = root

	local bb = Instance.new("BillboardGui")
	bb.Adornee = head
	bb.AlwaysOnTop = true
	bb.Size = UDim2.fromOffset(170, 40)
	bb.StudsOffset = Vector3.new(0, 2.5, 0)
	bb.Parent = head

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextSize = 13
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.3
	label.Parent = bb

	espObjs[model] = { hl = hl, box = box, bb = bb, label = label, hum = hum, root = root }
end

local function updateESP()
	local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not myRoot then return end

	for _, hum in ipairs(targets) do
		local model = hum.Parent
		if model and hum.Health > 0 and not espObjs[model] then
			local root = model:FindFirstChild("HumanoidRootPart")
			if root and (root.Position - myRoot.Position).Magnitude <= MAX_DISTANCE then
				addESP(hum)
			end
		end
	end

	for model, o in pairs(espObjs) do
		local root = o.root
		if not model.Parent or not root or not root.Parent or o.hum.Health <= 0
			or (root.Position - myRoot.Position).Magnitude > MAX_DISTANCE then
			clearESP(model)
		else
			local col = isTeammate(model) and TEAM_COLOR or ENEMY_COLOR
			o.hl.FillColor = col
			o.box.Color3 = col
			o.label.TextColor3 = col
			local dist = math.floor((root.Position - myRoot.Position).Magnitude)
			o.label.Text = string.format("%s\n%d HP | %dm", model.Name, math.floor(o.hum.Health), dist)
		end
	end
end

