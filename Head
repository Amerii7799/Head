		hum:ChangeState(Enum.HumanoidStateType.Jumping)
	end
end)

-- ===== aimbot: sticky head lock + prediction =====
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local locked = nil -- current locked Humanoid

local function aimPartOf(hum)
	local model = hum.Parent
	return model and (model:FindFirstChild(AIM_PART) or model:FindFirstChild("HumanoidRootPart"))
end

-- returns part if hum is a valid target right now (alive, in range, in FOV, visible)
local function validTarget(hum, myRoot, center)
	local model = hum.Parent
	local part = model and aimPartOf(hum)
	if not part or hum.Health <= 0 or isTeammate(model) then return nil end
	if (part.Position - myRoot.Position).Magnitude > MAX_DISTANCE then return nil end

	local sp, onScreen = camera:WorldToViewportPoint(part.Position)
	if not onScreen then return nil end
	local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
	if d > AIM_FOV then return nil end

	if not state.wallAim then
		local origin = camera.CFrame.Position
		local hit = Workspace:Raycast(origin, part.Position - origin, rayParams)
		if hit and not hit.Instance:IsDescendantOf(model) then return nil end
	end
	return part, d
end

local function aimStep()
	if not ready or not state.aimbot then locked = nil return end
	camera = Workspace.CurrentCamera
	local myChar = player.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	if not myRoot then return end

	rayParams.FilterDescendantsInstances = { myChar }
	local vp = camera.ViewportSize
	local center = Vector2.new(vp.X / 2, vp.Y / 2)

	-- keep current lock while still valid
	local part
	if locked then part = validTarget(locked, myRoot, center) end

	-- else pick closest-to-crosshair
	if not part then
		locked = nil
		local bestD = math.huge
		for _, hum in ipairs(targets) do
			local p, d = validTarget(hum, myRoot, center)
			if p and d < bestD then
				bestD, part, locked = d, p, hum
			end
		end
	end

	if part then
		local aimPos = part.Position + part.AssemblyLinearVelocity * PREDICTION
		local pos = camera.CFrame.Position
		camera.CFrame = camera.CFrame:Lerp(CFrame.new(pos, aimPos), AIM_SMOOTH)
	end
end

-- run right after the default camera script so it doesn't fight us
RunService:BindToRenderStep("AmerAim", Enum.RenderPriority.Camera.Value + 1, aimStep)

