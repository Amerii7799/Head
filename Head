local lastJump = 0
UserInputService.JumpRequest:Connect(function()
	if not ready or not state.infJump then return end
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum and hum.Health > 0 and os.clock() - lastJump >= JUMP_COOLDOWN then
